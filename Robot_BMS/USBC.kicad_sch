	(text "All standard Passive\ncomponenets are 0603 imperial"
		(exclude_from_sim no)
		(at 216.408 172.974 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "1797c260-ff2e-45ba-8fc7-aa0bad56f289")
	)
	(text "USB-C Connector & PD"
		(exclude_from_sim no)
		(at 87.122 19.304 0)
		(effects
			(font
				(size 7.62 7.62)
			)
		)
		(uuid "2727725b-4a7a-45b7-b16d-49cd4028d248")
	)
	(text "USB-C Connector"
		(exclude_from_sim no)
		(at 247.142 75.946 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "3a84877d-5262-449e-850f-81e346c880e7")
	)
	(text "When plugging in a USB-C cable \n5V appears but it will supply very low current.\nTo get 15V 3A PD the first 2 l.s.bits of\nregister PDO4_V must be written to via I2C\nWe are writing to Non-Volatile-Memory so \nit hasl imited write cycles.\n\nWrite 2b01 to register PD04_V\nthen to select 3A write to\nthe first 3 l.s.bits of PDO4_I 4b0111"
		(exclude_from_sim no)
		(at 107.442 175.26 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "41937031-5452-4380-aecd-13ce20ecfad6")
	)
	(text "VBUS => 15V"
		(exclude_from_sim no)
		(at 256.794 64.008 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "5076c9fe-8e11-4813-a301-a30ee36b2c6f")
	)
	(text "2 Ways TO Configure USB-C PD"
		(exclude_from_sim no)
		(at 61.214 155.956 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "74b01536-2bb9-4803-9a05-b4876975a62f")
	)
	(text "Helpful Link"
		(exclude_from_sim no)
		(at 163.322 194.31 0)
		(effects
			(font
				(size 2.54 2.54)
				(color 255 10 54 1)
			)
			(href "https://www.reddit.com/r/AskElectronics/comments/pw12y8/trying_to_understand_stusb4710_datasheet/?rdt=33915")
		)
		(uuid "ac681a81-8efc-483a-9993-19199585b82b")
	)
	(text "OverVoltage\nprotection\nVBUS > Vz(27V)\n"
		(exclude_from_sim no)
		(at 230.632 39.624 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "da64e5cf-5882-4654-b2c4-c27e2c188282")
	)
	(text "MCU Needs to detect when a \nUSB-C cable is plugged in\nMCU_USB_DETECT is at 3.3V \nmax 5mA will be drawn"
		(exclude_from_sim no)
		(at 209.042 53.594 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "e32707e6-b45b-440a-a2bd-3f9a07813bb4")
	)
	(text "Connect GPIO2/SEL_PDO4 to GND\nwhich defaults the chip to 15V 3A"
